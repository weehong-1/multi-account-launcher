<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ClaudeMultiAccountLauncher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClaudeMultiAccountLauncher"
    Title="Claude Multi-Account Launcher">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.Resources>
            <!-- Bundled copy first, so it works where JetBrains Mono isn't installed -->
            <FontFamily x:Key="MonoFont">ms-appx:///Assets/Fonts/JetBrainsMono-Regular.ttf#JetBrains Mono, Cascadia Mono, Consolas</FontFamily>
            <DataTemplate x:Key="ProfileRowTemplate" x:DataType="local:ProfileRow">
                <Grid
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    ColumnSpacing="12"
                    CornerRadius="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind Name, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Grid Width="8" Height="8" VerticalAlignment="Center">
                                <Ellipse Fill="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{x:Bind IsRunning, Mode=OneWay}" />
                                <Ellipse Fill="{ThemeResource ControlStrongFillColorDefaultBrush}" Visibility="{x:Bind IsNotRunning, Mode=OneWay}" />
                            </Grid>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind StatusText, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock
                            FontFamily="{StaticResource MonoFont}"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind FolderText}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind FolderText}" />
                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Click="LaunchButton_Click"
                        Content="Launch"
                        IsEnabled="{x:Bind CanLaunch, Mode=OneWay}"
                        Tag="{x:Bind}" />

                    <Button
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="More options"
                        Content="&#xE712;"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        ToolTipService.ToolTip="More options">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem
                                    Click="ShortcutMenu_Click"
                                    Tag="{x:Bind}"
                                    Text="Create desktop shortcut">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE71B;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    Click="QuitMenu_Click"
                                    IsEnabled="{x:Bind CanQuit, Mode=OneWay}"
                                    Tag="{x:Bind}"
                                    Text="Quit"
                                    Visibility="{x:Bind IsWhatsAppProfile}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE711;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator Visibility="{x:Bind IsCustom}" />
                                <MenuFlyoutItem
                                    Click="RenameMenu_Click"
                                    Tag="{x:Bind}"
                                    Text="Rename"
                                    Visibility="{x:Bind IsCustom}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8AC;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator Visibility="{x:Bind IsCustom}" />
                                <MenuFlyoutItem
                                    Click="RemoveMenu_Click"
                                    IsEnabled="{x:Bind CanRemove, Mode=OneWay}"
                                    Tag="{x:Bind}"
                                    Text="Remove"
                                    Visibility="{x:Bind IsCustom}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74D;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: content extends into it, Mica shows through -->
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0">
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Claude Multi-Account Launcher" />
        </Grid>

        <!-- A closed InfoBar only hides its content; Visibility follows IsOpen so it takes no space -->
        <StackPanel Grid.Row="1" Padding="24,8,24,12">
            <Grid>
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Profiles" />
                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        VerticalAlignment="Stretch"
                        AutomationProperties.Name="Launcher options"
                        Content="&#xE712;"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        ToolTipService.ToolTip="Launcher options">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Click="UninstallMenu_Click" Text="Uninstall and remove everything…">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74D;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button
                        x:Name="AddButton"
                        AutomationProperties.Name="Add profile"
                        Click="AddButton_Click"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                            <TextBlock Text="Add profile" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <InfoBar
                x:Name="ErrorBar"
                Margin="0,12,0,0"
                IsOpen="False"
                Severity="Error"
                Visibility="{x:Bind ErrorBar.IsOpen, Mode=OneWay}" />

            <InfoBar
                x:Name="NoticeBar"
                Margin="0,12,0,0"
                IsOpen="False"
                Severity="Success"
                Visibility="{x:Bind NoticeBar.IsOpen, Mode=OneWay}" />
        </StackPanel>

        <!-- Two sections, each with its Default first (WhatsApp spec section 3) -->
        <ScrollViewer Grid.Row="2">
            <StackPanel Margin="24,0,24,24" Spacing="8">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Claude" />
                <ItemsRepeater x:Name="ClaudeList" ItemTemplate="{StaticResource ProfileRowTemplate}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>

                <TextBlock
                    Margin="0,16,0,0"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="WhatsApp" />
                <ItemsRepeater x:Name="WhatsAppList" ItemTemplate="{StaticResource ProfileRowTemplate}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
                <TextBlock
                    x:Name="WhatsAppEmptyText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="WhatsApp Desktop isn't installed. Add a WhatsApp profile with Add profile."
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <TextBlock
            x:Name="FooterText"
            Grid.Row="3"
            Margin="24,0,24,12"
            FontFamily="{StaticResource MonoFont}"
            FontSize="11"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            IsTextSelectionEnabled="True"
            TextTrimming="CharacterEllipsis" />
    </Grid>
</Window>
