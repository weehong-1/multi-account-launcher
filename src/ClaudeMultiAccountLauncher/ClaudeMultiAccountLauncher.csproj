<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>ClaudeMultiAccountLauncher</RootNamespace>
    <AssemblyName>claude-multi-account-launcher</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Nullable>enable</Nullable>

    <!-- Shown in Explorer file properties and Task Manager -->
    <Product>Multi-Account Launcher</Product>
    <AssemblyTitle>Multi-Account Launcher</AssemblyTitle>
    <Description>Unofficial launcher that runs several Claude Desktop accounts side by side.</Description>
    <!-- Version comes from Directory.Build.props -->

    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Own Main in Program.cs: WhatsApp profiles hand off to their running process first (FR-W6) -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- WinUI 3, unpackaged, with the .NET and Windows App SDK runtimes bundled (spec section 6) -->
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!-- Needed so single-file publish can embed resources.pri; still unpackaged -->
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <!-- Single self-contained .exe (spec section 6) -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Windows App SDK 2.7 requires this for DLL SxS redirection and errors without it.
         .NET 11 calls it legacy (NETSDK1244); nothing we can change until the SDK does. -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);NETSDK1244</MSBuildWarningsAsMessages>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <!-- Don't copy referenced projects' .pdb next to the exe -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <!-- No trimming or AOT: WMI (System.Management) and IShellLink need built-in COM -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Window icon, and JetBrains Mono so paths look the same on PCs without it (spec section 6) -->
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\JetBrainsMono-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\JetBrainsMono-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.7.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClaudeMultiAccountLauncher.Core\ClaudeMultiAccountLauncher.Core.csproj" />
  </ItemGroup>

</Project>
